+        pthread_join(thread_, nullptr);
+#else
+        thread_.join();
+#endif
+    }
+    void detach() {
+#ifdef __SWITCH__
+        pthread_detach(thread_);
+#else
+        thread_.detach();
+#endif
+    }
+
+private:
+#ifdef __SWITCH__
+    static constexpr std::size_t kStackSize = 16u << 20;
+    pthread_t thread_{};
+#else
+    std::thread thread_;
+#endif
+};
