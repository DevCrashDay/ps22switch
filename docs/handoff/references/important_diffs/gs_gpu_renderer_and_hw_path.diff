+
+const CLUT_ENTRIES: u32 = 512u;
+const F_IIP: u32 = 1u;
+const F_TME: u32 = 2u;
+const F_FGE: u32 = 4u;
+const F_ABE: u32 = 8u;
+const F_FST: u32 = 16u;
+const F_ATE: u32 = 64u;
+const F_FBA: u32 = 4096u;
+const F_TCC: u32 = 8192u;
+const F_BILINEAR: u32 = 16384u;
+const F_AEM: u32 = 32768u;
