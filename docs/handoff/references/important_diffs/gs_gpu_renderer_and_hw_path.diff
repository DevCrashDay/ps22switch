+fn box_pixel(gid: vec3<u32>, xy: ptr<function, vec2<u32>>) -> bool {
+    let x0 = prm(5u) & 0xFFFFu;
+    let y0 = prm(5u) >> 16u;
+    let x1 = prm(6u) & 0xFFFFu;
+    let y1 = prm(6u) >> 16u;
+    let x = x0 + gid.x;
+    let y = y0 + gid.y;
+    *xy = vec2<u32>(x, y);
+    return x <= x1 && y <= y1;
