+
+fn pack(c: vec4<f32>) -> u32 {
+    let b = vec4<u32>(clamp(round(c * 255.0), vec4<f32>(0.0), vec4<f32>(255.0)));
+    return b.x | (b.y << 8u) | (b.z << 16u) | (b.w << 24u);
