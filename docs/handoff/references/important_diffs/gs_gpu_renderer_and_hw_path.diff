+            mask = 0xFFFFu;
+        }
+        case 0x3Au {
+            a = page_addr(bp, bw, x, y, 64u, 64u) + tables[T_OFFZ16S + (y & 63u) * 64u + (x & 63u)];
+            shift = (a & 2u) * 8u;
+            mask = 0xFFFFu;
+        }
+        default {
+            a = page_addr(bp, bw, x, y, 64u, 32u) + tables[T_OFF32 + (y & 31u) * 64u + (x & 63u)];
+        }
