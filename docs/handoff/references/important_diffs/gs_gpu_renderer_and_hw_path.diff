+fn read_pixel(psm: u32, bp: u32, bw: u32, x: u32, y: u32) -> u32 {
+    let l = locate(psm, bp, bw, x, y);
+    return (atomicLoad(&vram[l.word]) >> l.shift) & l.mask;
