+struct Tex {
+    flags: u32,
+    modes: u32,
+    aref: u32,
+    tw: u32,
+    th: u32,
+    cpsm: u32,
+    csa: u32,
+    minu: u32,
+    maxu: u32,
+    minv: u32,
+    maxv: u32,
+    ta0: u32,
+    ta1: u32,
+    fogcol: u32,
+    clut: u32,
+    tpsm: u32,
+    tf: Fmt,
+    dec: u32,
