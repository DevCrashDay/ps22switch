+        held.clear();
+        out.push_back(c);
+        last = c.hw == 3 ? static_cast<std::ptrdiff_t>(out.size() - 1) : -1;
+    }
+    out.insert(out.end(), held.begin(), held.end());
+    g_commands.swap(out);
